              "raw": "{\n  \"nombre\": \"Paciente\",\n  \"apellido\": \"Prueba\",\n  \"dni\": \"48999111\",\n  \"email\": \"paciente@prueba.test\",\n  \"telefono\": \"3424000000\",\n  \"fecha_nacimiento\": \"1998-05-10\",\n  \"password\": \"prueba123\",\n  \"id_cobertura\": 1\n}",
